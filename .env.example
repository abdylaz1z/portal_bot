BOT_TOKEN=replace-with-telegram-bot-token
DATABASE_URL=postgresql+asyncpg://oshtu_bot:replace-me@localhost:5432/oshtu_bot
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./data/oshtu_bot.db
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
REDIS_URL=redis://localhost:6379/0
WEBHOOK_DOMAIN=bot.example.org
WEBHOOK_PUBLIC_URL=https://bot.example.org
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace-with-a-random-url-safe-secret
WEBHOOK_MAX_CONNECTIONS=40
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
